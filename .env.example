# Скопируйте этот файл в .env.local и заполните значениями
# из вашего проекта Supabase (Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно: email-уведомление паре о новом RSVP-ответе.
# Без этих переменных RSVP всё равно нормально сохраняется —
# просто письмо не отправится. См. README, раздел «Email-уведомления».
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RSVP_WEBHOOK_SECRET=придумайте-любую-случайную-строку
